# ---------------------------------------------------------------------------
# Purasynth — environment variables
# Copy to .env.local for local dev, and add the same keys in
# Netlify → Site configuration → Environment variables for production.
# ---------------------------------------------------------------------------

# Absolute origin, no trailing slash. Used for canonical URLs, sitemap,
# Open Graph images and the product feed.
NEXT_PUBLIC_SITE_URL=https://purasynth.netlify.app

# --- Order storage (Supabase) ----------------------------------------------
# Create a free project at supabase.com, then run supabase/schema.sql in the
# SQL editor. The service role key bypasses Row Level Security, so it must
# NEVER carry a NEXT_PUBLIC_ prefix and must never be used in a client file.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# There is deliberately no email-alert provider. Orders land in the table above
# and the dashboard at /admin reads the same table, so a new order is visible
# the moment it is saved — no delivery service sits in between to fail.

# --- Admin dashboard --------------------------------------------------------
# Password for /admin. Use a long random string.
ADMIN_PASSWORD=
# Secret used to sign the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
